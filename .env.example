# 站内搜索：Algolia DocSearch / Search 配置（留空时自动降级启用 VitePress 本地搜索）
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_API_KEY=
ALGOLIA_INDEX_NAME=

# 仅构建/索引脚本使用的服务端写入密钥（严禁注入前端代码）
ALGOLIA_ADMIN_API_KEY=

# 搜索引擎站长平台验证 Meta（仅填写 content 值）
VITEPRESS_META_GOOGLE=
VITEPRESS_META_BING=
VITEPRESS_META_SHENMA=
VITEPRESS_META_BAIDU=
