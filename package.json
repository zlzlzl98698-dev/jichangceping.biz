{
  "name": "airport-review-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "机场测评 (jichangceping.biz) - VitePress 专业测评知识库、SEO/GEO 内容工程及商业转化平台",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "node scripts/prebuild.mjs && vitepress build docs && node scripts/postbuild.mjs",
    "docs:preview": "vitepress preview docs",
    "audit:sources": "node scripts/audit-sources.mjs",
